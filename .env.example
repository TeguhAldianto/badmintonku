# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/badmintonku"

# Auth (NextAuth v5)
AUTH_SECRET="replace-with-long-random-secret"

# App
APP_URL="http://localhost:3000"
APP_TIME_ZONE="Asia/Jakarta"
NODE_ENV="development"

# Midtrans
# MIDTRANS_SERVER_KEY is server-only. NEXT_PUBLIC_MIDTRANS_CLIENT_KEY is required by browser Snap.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# WhatsApp (Fonnte)
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_KEY=""
# Optional legacy alias supported by notification service
# FONNTE_API_KEY=""
# Optional, not used by current code
# DEFAULT_WHATSAPP_TARGET=""

# Cron
# Required by GET /api/cron/expire-bookings (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
